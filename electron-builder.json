{
  "appId": "com.maitham.warehouse",
  "productName": "نظام إدارة المخازن",
  "copyright": "Copyright © 2025 ميثم",
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "نظام إدارة المخازن",
    "artifactName": "Warehouse-Setup-${version}.exe"
  },
  "portable": {
    "artifactName": "Warehouse-Portable.exe"
  }
}
