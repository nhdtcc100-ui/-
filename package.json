{
  "name": "warehouse-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "نظام إدارة المخازن - تطبيق سطح المكتب",
  "author": "ميثم",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "cross-env ELECTRON=true npm run build && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "bootstrap": "^5.3.8",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
